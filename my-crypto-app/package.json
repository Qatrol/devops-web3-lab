{
  "name": "my-crypto-app",
  "version": "0.1.0",
  "description": "A Bun-first scaffold for Ethereum projects",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && sherif",
    "test": "bun test packages/sdk",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.29.7",
    "@types/bun": "^1.1.10",
    "next-bun-docker": "^1.0.0",
    "sherif": "^1.1.0",
    "tsup": "^8.5.1",
    "turbo": "^2.5.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "bun@1.3.1",
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bun-Eth-Community/bun-eth.git"
  },
  "keywords": [
    "ethereum",
    "bun",
    "elysia",
    "foundry",
    "forge",
    "anvil",
    "web3",
    "scaffold"
  ]
}
